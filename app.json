{
  "expo": {
    "name": "NFlix",
    "slug": "nflix-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.nflix.stream",
      "permissions": [
        "INTERNET"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#141414"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}